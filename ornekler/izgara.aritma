"acs":50},{"id":7796,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,24.51523517226981,0],"h":0.095,"s":"13 – Kalıp hazırlanması, donatının yerleştirilmesi, betonun dökülmesi sertifikalı elemanlar tarafından, şantiye şefi inşaat","rot":0,"al":"L","ann":false,"acs":50},{"id":7798,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.6760133338619,24.370235172269812,0],"h":0.095,"s":"mühendisinin denetiminde TS 500 kurallarına uygun yapılacaktır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7800,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,24.225235172269812,0],"h":0.095,"s":"14 – Kalıp hazırlanırken boru delikleri mekanik projesine göre bırakılacaktır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7802,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,24.080235172269813,0],"h":0.095,"s":"15 – Kalıp hazırlanırken mimari, betonarme, elektrik ve mekanik projeleri karşılaştırılacak, çelişkili durum varsa şantiye","rot":0,"al":"L","ann":false,"acs":50},{"id":7804,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.6760133338619,23.935235172269813,0],"h":0.095,"s":"yetkilisine bildirilecek, uyum sağlandıktan sonra imalat yapılacaktır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7806,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,23.790235172269814,0],"h":0.095,"s":"16 – Beton dökülürken vibratör kullanılacaktır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7808,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,23.645235172269814,0],"h":0.095,"s":"17 – İklim durumuna göre şantiye şefinin gözetiminde betonun periyodik olarak sula