,26.545235172269805,0],"h":0.095,"s":"4 – BETON SINIFI: Su tutucu yapılarda C30/37 WR (sülfata dayanıklı çimentolu), su tutucu olmayan (bina tipi) yapılarda C30/37","rot":0,"al":"L","ann":false,"acs":50},{"id":7770,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.6760133338619,26.400235172269806,0],"h":0.095,"s":"olacaktır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7772,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,26.255235172269806,0],"h":0.095,"s":"5 – ÇELİK SINIFI: B 420C olacaktır. Çelik konstrüksiyon malzeme kalitesi: \"St.37/2\".","rot":0,"al":"L","ann":false,"acs":50},{"id":7774,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,26.110235172269807,0],"h":0.095,"s":"6 – Kazı şev eğimleri \"1/n\" alınmış olup \"n\" değeri jeolojik raporda verilen ve zemine bağlı olarak değişen değerlere uygun olarak","rot":0,"al":"L","ann":false,"acs":50},{"id":7776,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.6760133338619,25.965235172269807,0],"h":0.095,"s":"kontrol mühendisince yerinde belirlenecektir.","rot":0,"al":"L","ann":false,"acs":50},{"id":7778,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,25.820235172269808,0],"h":0.095,"s":"7 – Yapıların yapılacağı zeminlerin durumları ile ilgili olarak alınacak önlemler için jeoteknik etüt raporuna bakınız.","rot":0,"al":"L","ann":false,"acs":50},{"id":7780,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,25.675235172269808,0],"h":0.095,"s":"8 – Kazı sırasında yeraltı suyu çıkarsa kontrol mühendisine haber verilecek ve çıkan yeraltı suyu pompaj ile uzaklaştırılacaktır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7782,"type":"text","layer":