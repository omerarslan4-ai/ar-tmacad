ayer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.6760133338619,22.630235172269817,0],"h":0.095,"s":"alınmalıdır.","rot":0,"al":"L","ann":false,"acs":50},{"id":7824,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,22.485235172269817,0],"h":0.095,"s":"23 – Beton mukavemeti gerekli değere ulaştığında şantiye şefinin izni ile kalıp sökülecektir.","rot":0,"al":"L","ann":false,"acs":50},{"id":7826,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,22.340235172269818,0],"h":0.095,"s":"24 – Kullanılacak yalıtım ve detayları için ilgili mimari paftaya bakınız.","rot":0,"al":"L","ann":false,"acs":50},{"id":7828,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,22.19523517226982,0],"h":0.095,"s":"25 – Aksi belirtilmedikçe temel planı üstten bakılarak, kalıp planları alttan bakılarak çizilmiştir.","rot":0,"al":"L","ann":false,"acs":50},{"id":7830,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,22.05023517226982,0],"h":0.095,"s":"26 – Derzler betonarme projesi esas alınarak teşkil edilecektir. Derz detayları için \"Derz Detayları\" paftasına bakınız.","rot":0,"al":"L","ann":false,"acs":50},{"id":7832,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,21.90523517226982,0],"h":0.095,"s":"27 – Kaide betonları imalatçı firma tarafından projelendirilecektir.","rot":0,"al":"L","ann":false,"acs":50},{"id":7834,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw4z8tdh_5","p":[492.47601333386183,21.76023517226982,0],"h":0.095,"s":"28 – Perde düşey donatıları: yüksekliği 2.00 m'ye kadar olan perdelerde filizsiz, tek parça ve gönyeli; 2.00 m – 6.00 m arasında","rot":0,"al":"L","ann":fa