269814,0],"h":0.095,"s":"18 – Su ile temas eden yüzeylerde \"F3\", su ile temas etmeyen yüzeylerde \"F1\" beton yüzey sınıfı sağlanmalıdır.","rot":0,"al":"L","ann":false,"acs":100},{"id":52418,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,23.355235172269815,0],"h":0.095,"s":"19 – Kullanılacak çelik donatı TSE belgeli olacaktır. Mukavemet değerleri laboratuvarda test edilmeden imalata geçilmeyecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":52419,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,23.210235172269815,0],"h":0.095,"s":"20 – Beton, beton santrallerinde TS EN 206'ya uygun şekilde imal edilecek ve TS 1247 ve TS 1248'e uygun dökülecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":52420,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,23.065235172269816,0],"h":0.095,"s":"21 – Aksi belirtilmedikçe demirlerde bindirme (filiz) boyları Ø12: 70, Ø14: 80, Ø16: 90, Ø18: 100, Ø20: 110, Ø22: 120, Ø24: 130,","rot":0,"al":"L","ann":false,"acs":100},{"id":52421,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.2581650265703,22.920235172269816,0],"h":0.095,"s":"Ø26: 140 cm'den az alınmayacaktır. Perdelerin yatay donatılarının bindirmeli eklerinde 90 derecelik kanca yapılacaktır (TBDY 2018).","rot":0,"al":"L","ann":false,"acs":100},{"id":52422,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,22.775235172269817,0],"h":0.095,"s":"22 – Döşeme ve radye temel üst donatıları kesinlikle üstte tutulmalıdır. Donatıya basılmamalı ve üstte tutulması için sehpa önlemi","rot":0,"al":"L","ann":false,"acs":100},{"id":52423,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.2581650265703,22.630235172269817,0],"h":0.095,"s":"alınmalıdır.","rot":0,"al":"L","ann":false,"acs":100},{"id":52424,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,22.485235172269817,0],"h":0.095,"s":"23 – Beton mukavemeti gerekli değere ulaştığında şantiye şefinin izni ile kalıp sökülecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":52425,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,22.340235172269818,0],"h":0.095,"s":"24 – Kullanılacak yalıtım ve detayları için ilgili mimari paftaya bakınız.","rot":0,"al":"L","ann":false,"acs":100},{"id":52426,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,22.19523517226982,0],"h":0.095,"s":"25 – Aksi belirtilmedikçe temel planı üstten bakılarak, kalıp planları alttan bakılarak çizilmiştir.","rot":0,"al":"L","ann":false,"acs":100},{"id":52427,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,22.05023517226982,0],"h":0.095,"s":"26 – Derzler betonarme projesi esas alınarak teşkil edilecektir. Derz detayları için \"Derz Detayları\" paftasına bakınız.","rot":0,"al":"L","ann":false,"acs":100},{"id":52428,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,21.90523517226982,0],"h":0.095,"s":"27 – Kaide betonları imalatçı firma tarafından projelendirilecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":52429,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,21.76023517226982,0],"h":0.095,"s":"28 – Donatı kanca ve gönyeleri merdane ile bükülecektir. Bükme merdane çapı Ø ≤ 16 için 4Ø, Ø > 16 için 7Ø'dir (TS EN 1992-1-1","rot":0,"al":"L","ann":false,"acs":100},{"id":52430,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.2581650265703,21.61523517226982,0],"h":0.095,"s":"Tablo 8.1N); sıcak bükme ve düzeltme yapılmayacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":52431,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,21.47023517226982,0],"h":0.095,"s":"29 – Perde düşey donatıları: yüksekliği 2.00 m'ye kadar olan perdelerde filizsiz, tek parça ve gönyeli; 2.00 m – 6.00 m arasında","rot":0,"al":"L","ann":false,"acs":100},{"id":52432,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.2581650265703,21.32523517226982,0],"h":0.095,"s":"temel filizi üzerine bindirmeli; 6.00 m ve üzerinde temel filizi, orta ve üst (döşemeye kadar) olmak üzere üç parça yapılacak,","rot":0,"al":"L","ann":false,"acs":100},{"id":52433,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.2581650265703,21.18023517226982,0],"h":0.095,"s":"perde ortasında su tutucu bantlı inşaat derzi teşkil edilecektir. Bindirme boyları çapa göre \"Demirlerde Bindirme Boyları\"","rot":0,"al":"L","ann":false,"acs":100},{"id":52434,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.2581650265703,21.03523517226982,0],"h":0.095,"s":"tablosundadır (Ø12: 70 … Ø26: 140 cm).","rot":0,"al":"L","ann":false,"acs":100},{"id":52435,"type":"text","layer":"STA_BASLIK","color":2,"lt":"CONTINUOUS","lw":50,"gv":"STATIK_mw9i0ro2_0","p":[620.0581650265702,20.73523517226982,0],"h":0.17,"s":"PASPAYI","rot":0,"al":"L","ann":false,"acs":100},{"id":52436,"type":"line","layer":"STA_BASLIK","color":2,"lt":"CONTINUOUS","lw":50,"gv":"STATIK_mw9i0ro2_0","a":[620.0581650265702,20.68023517226982,0],"b":[620.8281650265702,20.68023517226982,0]},{"id":52437,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro2_0","p":[620.1581650265703,20.420235172269823,0],"h":0.10500000000000001,"s":"• D