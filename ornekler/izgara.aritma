cs":100},{"id":57583,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,25.820235172269808,0],"h":0.095,"s":"7 – Yapıların yapılacağı zeminlerin durumları ile ilgili olarak alınacak önlemler için jeoteknik etüt raporuna bakınız.","rot":0,"al":"L","ann":false,"acs":100},{"id":57584,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,25.675235172269808,0],"h":0.095,"s":"8 – Kazı sırasında yeraltı suyu çıkarsa kontrol mühendisine haber verilecek ve çıkan yeraltı suyu pompaj ile uzaklaştırılacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57585,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,25.53023517226981,0],"h":0.095,"s":"9 – Kazı sonucunda zeminin, zemin etüt raporunda ve proje tasarım kriterlerinde belirtilen nitelikte olmadığı görüldüğü takdirde","rot":0,"al":"L","ann":false,"acs":100},{"id":57586,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,25.38523517226981,0],"h":0.095,"s":"ilgililere bilgi verilecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57587,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,25.24023517226981,0],"h":0.095,"s":"10 – Zeminde betona zararlı kimyasal maddelerin bulunması durumunda TS 3440'a göre önlem alınacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57588,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,25.09523517226981,0],"h":0.095,"s":"11 – Dolgu malzemesinin sıkışma oranı minimum %95 olmalıdır. Proje sahasında yapılacak dolguda minimum %95 proktor sıklığı ve","rot":0,"al":"L","ann":false,"acs":100},{"id":57589,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,24.95023517226981,0],"h":0.095,"s":"minimum Es=40 MPa deformasyon modülü değeri aranacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57590,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,24.80523517226981,0],"h":0.095,"s":"12 – Tüm borular sızdırmazlık yakaları kaynatılarak beton dökülmeden önce yerleştirilecektir. Boru deliklerinin beton kırılarak","rot":0,"al":"L","ann":false,"acs":100},{"id":57591,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,24.66023517226981,0],"h":0.095,"s":"açılmasına asla izin verilmeyecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57592,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,24.51523517226981,0],"h":0.095,"s":"13 – Kalıp hazırlanması, donatının yerleştirilmesi, betonun dökülmesi sertifikalı elemanlar tarafından, şantiye şefi inşaat","rot":0,"al":"L","ann":false,"acs":100},{"id":57593,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,24.370235172269812,0],"h":0.095,"s":"mühendisinin denetiminde TS 500 kurallarına uygun yapılacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57594,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,24.225235172269812,0],"h":0.095,"s":"14 – Kalıp hazırlanırken boru delikleri mekanik projesine göre bırakılacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57595,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,24.080235172269813,0],"h":0.095,"s":"15 – Kalıp hazırlanırken mimari, betonarme, elektrik ve mekanik projeleri karşılaştırılacak, çelişkili durum varsa şantiye","rot":0,"al":"L","ann":false,"acs":100},{"id":57596,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,23.935235172269813,0],"h":0.095,"s":"yetkilisine bildirilecek, uyum sağlandıktan sonra imalat yapılacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57597,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,23.790235172269814,0],"h":0.095,"s":"16 – Beton dökülürken vibratör kullanılacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57598,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,23.645235172269814,0],"h":0.095,"s":"17 – İklim durumuna göre şantiye şefinin gözetiminde betonun periyodik olarak sulanması sağlanacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57599,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,23.500235172269814,0],"h":0.095,"s":"18 – Su ile temas eden yüzeylerde \"F3\", su ile temas etmeyen yüzeylerde \"F1\" beton yüzey sınıfı sağlanmalıdır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57600,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,23.355235172269815,0],"h":0.095,"s":"19 – Kullanılacak çelik donatı TSE belgeli olacaktır. Mukavemet değerleri laboratuvarda test edilmeden imalata geçilmeyecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57601,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,23.210235172269815,0],"h":0.095,"s":"20 – Beton, beton santrallerinde TS EN 206'ya uygun şekilde imal edilecek ve TS 1247 ve TS 1248'e uygun dökülecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57602,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,23.065235172269816,0],"h":0.095,"s":"21 – Aksi belirtilmedikçe demirlerde bindirme (filiz) boyları Ø12: 70, Ø14: 80, Ø16: 90, Ø18: 100, Ø20: 110, Ø22: 120, Ø24: 130,","rot":0,"al":"L","ann":false,"acs":100},{"id":57603,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,22.920235172269816,0],"h":0.095,"s":"Ø26: 140 cm'den az alınmayacaktır. Perdelerin yatay donatılarının bindirmeli eklerinde 90 derecelik kanca yapılacaktır (TBDY 2018).","rot":0,"al":"L","ann":false,"acs":100},{"id":57604,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,22.775235172269817,0],"h":0.095,"s":"22 – Döşeme ve radye temel üst donatıları kesinlikle üstte tutulmalıdır. Donatıya basılmamalı ve üstte tutulması için sehpa önlemi","rot":0,"al":"L","ann":false,"acs":100},{"id":57605,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,22.630235172269817,0],"h":0.095,"s":"alınmalıdır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57606,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,22.485235172269817,0],"h":0.095,"s":"23 – Beton mukavemeti gerekli değere ulaştığında şantiye şefinin izni ile kalıp sökülecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57607,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,22.340235172269818,0],"h":0.095,"s":"24 – Kullanılacak yalıtım ve detayları için ilgili mimari paftaya bakınız.","rot":0,"al":"L","ann":false,"acs":100},{"id":57608,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,22.19523517226982,0],"h":0.095,"s":"25 – Aksi belirtilmedikçe temel planı üstten bakılarak, kalıp planları alttan bakılarak çizilmiştir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57609,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,22.05023517226982,0],"h":0.095,"s":"26 – Derzler betonarme projesi esas alınarak teşkil edilecektir. Derz detayları için \"Derz Detayları\" paftasına bakınız.","rot":0,"al":"L","ann":false,"acs":100},{"id":57610,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,21.90523517226982,0],"h":0.095,"s":"27 – Kaide betonları imalatçı firma tarafından projelendirilecektir.","rot":0,"al":"L","ann":false,"acs":100},{"id":57611,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,21.76023517226982,0],"h":0.095,"s":"28 – Donatı kanca ve gönyeleri merdane ile bükülecektir. Bükme merdane çapı Ø ≤ 16 için 4Ø, Ø > 16 için 7Ø'dir (TS EN 1992-1-1","rot":0,"al":"L","ann":false,"acs":100},{"id":57612,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,21.61523517226982,0],"h":0.095,"s":"Tablo 8.1N); sıcak bükme ve düzeltme yapılmayacaktır.","rot":0,"al":"L","ann":false,"acs":100},{"id":57613,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,21.47023517226982,0],"h":0.095,"s":"29 – Perde düşey donatıları: yüksekliği 2.00 m'ye kadar olan perdelerde filizsiz, tek parça ve gönyeli; 2.00 m – 6.00 m arasında","rot":0,"al":"L","ann":false,"acs":100},{"id":57614,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,21.32523517226982,0],"h":0.095,"s":"temel filizi üzerine bindirmeli; 6.00 m ve üzerinde temel filizi, orta ve üst (döşemeye kadar) olmak üzere üç parça yapılacak,","rot":0,"al":"L","ann":false,"acs":100},{"id":57615,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,21.18023517226982,0],"h":0.095,"s":"perde ortasında su tutucu bantlı inşaat derzi teşkil edilecektir. Bindirme boyları çapa göre \"Demirlerde Bindirme Boyları\"","rot":0,"al":"L","ann":false,"acs":100},{"id":57616,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.2687335036278,21.03523517226982,0],"h":0.095,"s":"tablosundadır (Ø12: 70 … Ø26: 140 cm).","rot":0,"al":"L","ann":false,"acs":100},{"id":57617,"type":"text","layer":"STA_BASLIK","color":2,"lt":"CONTINUOUS","lw":50,"gv":"STATIK_mw9i0ro6_5","p":[895.0687335036278,20.73523517226982,0],"h":0.17,"s":"PASPAYI","rot":0,"al":"L","ann":false,"acs":100},{"id":57618,"type":"line","layer":"STA_BASLIK","color":2,"lt":"CONTINUOUS","lw":50,"gv":"STATIK_mw9i0ro6_5","a":[895.0687335036278,20.68023517226982,0],"b":[895.8387335036277,20.68023517226982,0]},{"id":57619,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.1687335036278,20.420235172269823,0],"h":0.10500000000000001,"s":"• Döşemelerde","rot":0,"al":"L","ann":false,"acs":100},{"id":57620,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[898.5687335036278,20.420235172269823,0],"h":0.10500000000000001,"s":": 2.5 cm","rot":0,"al":"L","ann":false,"acs":100},{"id":57621,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.1687335036278,20.255235172269824,0],"h":0.10500000000000001,"s":"• Perdelerde","rot":0,"al":"L","ann":false,"acs":100},{"id":57622,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[898.5687335036278,20.255235172269824,0],"h":0.10500000000000001,"s":": 5 cm","rot":0,"al":"L","ann":false,"acs":100},{"id":57623,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i0ro6_5","p":[895.1687335036278,20.090235172269825,0],"h":0.10500000000000001,"s":"• Temelde","rot":0,"al":"L","ann":false,"acs":100},{"id":57624,"type":"text","layer":"STA_YAZI","color":7,"lt":"CONTINUOUS","lw":25,"gv":"STATIK_mw9i